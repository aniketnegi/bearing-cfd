FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          incompressibleVoF;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         5;
deltaT          1;

writeControl    timeStep;
writeInterval   1;
purgeWrite      5;
writeFormat     binary;
writePrecision  12;
writeCompression off;

runTimeModifiable true;
