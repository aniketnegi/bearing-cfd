FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          incompressibleFluid;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;

writeControl    timeStep;
writeInterval   50;
purgeWrite      3;
writeFormat     binary;
writePrecision  12;
writeCompression off;

runTimeModifiable false;
