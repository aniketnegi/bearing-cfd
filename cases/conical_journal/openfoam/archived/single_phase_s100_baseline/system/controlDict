FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          incompressibleFluid;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         10000;
deltaT          1;

writeControl    timeStep;
writeInterval   20;
purgeWrite      2;
writeFormat     binary;
writePrecision  12;
writeCompression off;

runTimeModifiable false;
