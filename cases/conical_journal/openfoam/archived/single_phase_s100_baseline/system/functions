journalForces
{
    type            forces;
    libs            ("libforces.so");
    writeControl    timeStep;
    writeInterval   1;
    log             true;
    patches         (journal_wall);
    rho             rhoInf;
    rhoInf          860;
    pRef            0;
    CofR            (0 -3e-05 0.03);
