FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          incompressibleVoF;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         145;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      2;

writeFormat     binary;

writePrecision  12;

writeCompression off;

runTimeModifiable true;


