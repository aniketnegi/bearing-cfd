FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.oil;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    journal_wall
    {
        type            zeroGradient;
    }

    stationary_wall
    {
        type            zeroGradient;
    }

    axial_end_z0
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }

    axial_end_zl
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }

    pressure_feed
    {
        type            fixedValue;
        value           uniform 1;
    }
}
