FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}

#includeFunc patchFlowRate(name=feedFlowRate, patch=pressure_feed)
#includeFunc patchFlowRate(name=z0FlowRate, patch=axial_end_z0)
#includeFunc patchFlowRate(name=zlFlowRate, patch=axial_end_zl)

netBoundaryFlow
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    log             true;
    writeFields     false;
    patches         (pressure_feed axial_end_z0 axial_end_zl);
    operation       sum;
    fields          (phi);
}

