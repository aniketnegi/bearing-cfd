FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      T.oil;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 323.15;

boundaryField
{
    journal_wall
    {
        type            calculated;
        value           uniform 323.15;
    }
    stationary_wall
    {
        type            calculated;
        value           uniform 323.15;
    }
    axial_end_z0
    {
        type            calculated;
        value           uniform 323.15;
    }
    axial_end_zl
    {
        type            calculated;
        value           uniform 323.15;
    }
    pressure_feed
    {
        type            calculated;
        value           uniform 323.15;
    }
}


